{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=api",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
