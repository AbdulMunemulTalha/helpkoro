# HelpKoro local environment (development defaults only — no real secrets)
# Copy to .env and adjust. Docker Compose in infra/ provides matching services.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# --- PostgreSQL ---
DATABASE_URL=postgresql://helpkoro:helpkoro@localhost:5432/helpkoro

# --- Redis (queues / rate limits) ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (MinIO in local dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=helpkoro
S3_SECRET_ACCESS_KEY=helpkoro-dev-secret
S3_BUCKET_PRIVATE=helpkoro-evidence
S3_BUCKET_PUBLIC=helpkoro-public

# --- Observability (OpenTelemetry) ---
# Tracing is enabled only when an OTLP endpoint is set; otherwise the API runs with a no-op exporter.
OTEL_SERVICE_NAME=helpkoro-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- HTTP conventions (see docs/12-decisions/adr-006-api-and-scaffolding-conventions.md) ---
# Header used to propagate and echo the request correlation id.
REQUEST_ID_HEADER=x-request-id

# --- Web apps ---
# API_URL is the SERVER-SIDE base URL the Next.js web app (apps/web) uses to reach
# the API. The API enables no CORS and sets httpOnly cookies, so the browser never
# calls it directly — apps/web is a server-side BFF that proxies every request
# (RSC reads + server actions) server-to-server. This value is read only in server
# code and is never exposed to the client bundle. The web app itself serves on port
# 3000 (`pnpm --filter web dev`); the API on 3001.
API_URL=http://localhost:3001

# Demo organizer for local dev/CI seeding (packages/db seed). Creates a signed-in-able
# organizer that owns the seeded demo live campaigns. Never seeded in production.
# DEMO_ORGANIZER_EMAIL=organizer@helpkoro.test
# DEMO_ORGANIZER_PASSWORD=helpkoro-dev-organizer-1

# --- Auth (see docs/12-decisions/adr-007-authentication-sessions-and-rbac.md) ---
# Token signing secrets: each must be >= 32 chars and the two must differ.
# The API falls back to built-in DEV secrets when these are unset, so local dev
# and CI work out of the box; production REJECTS the fallbacks — set strong,
# distinct values from your secret store there.
# AUTH_ACCESS_TOKEN_SECRET=change-me-dev-only-min-32-characters-long
# AUTH_REFRESH_TOKEN_SECRET=change-me-dev-only-min-32-characters-different
# Token lifetimes (seconds): access 15 min, refresh 14 days.
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
# How long a step-up (re-auth) stays fresh for sensitive actions (seconds).
# AUTH_STEP_UP_WINDOW_SECONDS=300
# Set the Secure flag on auth cookies. Defaults to true; set false for local http.
AUTH_COOKIE_SECURE=false
# Optional cookie domain for first-party web apps (host-only when unset).
# AUTH_COOKIE_DOMAIN=localhost
