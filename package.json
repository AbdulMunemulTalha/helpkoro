{
  "name": "helpkoro",
  "version": "0.0.0",
  "private": true,
  "description": "HelpKoro — Bangladesh-first fundraising platform (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.1"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:status": "node scripts/build-status.mjs",
    "build:status:check": "node scripts/build-status.mjs --check",
    "services:up": "docker compose -f infra/docker-compose.yml up -d",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "services:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  }
}
