# HelpKoro local environment (development defaults only — no real secrets)
# Copy to .env and adjust. Docker Compose in infra/ provides matching services.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# --- PostgreSQL ---
DATABASE_URL=postgresql://helpkoro:helpkoro@localhost:5432/helpkoro

# --- Redis (queues / rate limits) ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (MinIO in local dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=helpkoro
S3_SECRET_ACCESS_KEY=helpkoro-dev-secret
S3_BUCKET_PRIVATE=helpkoro-evidence
S3_BUCKET_PUBLIC=helpkoro-public

# --- Observability (OpenTelemetry) ---
# Tracing is enabled only when an OTLP endpoint is set; otherwise the API runs with a no-op exporter.
OTEL_SERVICE_NAME=helpkoro-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- HTTP conventions (see docs/12-decisions/adr-006-api-and-scaffolding-conventions.md) ---
# Header used to propagate and echo the request correlation id.
REQUEST_ID_HEADER=x-request-id

# --- Web apps ---
# Base URL the Next.js apps use to reach the API.
API_URL=http://localhost:3001

# --- Auth (implemented in the Phase 0 step-4 follow-up; placeholders only) ---
# AUTH_ACCESS_TOKEN_SECRET=change-me-dev-only
# AUTH_REFRESH_TOKEN_SECRET=change-me-dev-only
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
